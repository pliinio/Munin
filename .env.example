# Munin — Environment Configuration Template
# Copy to .env and fill in values:
#   cp .env.example .env
#   nano .env

# ── Dashboard Authentication ──────────────────────────────────────────────────
# Secret key for Flask sessions (auto-generated by setup.sh / install.ps1)
MUNIN_SECRET_KEY=replace-with-a-random-64-char-hex-string

# Dashboard login credentials
MUNIN_DASHBOARD_USER=admin
MUNIN_DASHBOARD_PASS=changeme   # CHANGE THIS before first use

# Dashboard network settings
MUNIN_DASHBOARD_PORT=5000

# Session timeout in seconds (default: 1 hour)
MUNIN_SESSION_TIMEOUT=3600

# Optional: comma-separated IPs allowed to access the dashboard
# Leave empty to allow all IPs (use only on trusted networks)
# Example: 192.168.1.10,192.168.1.20
MUNIN_IP_ALLOWLIST=

# ── NLP / Ollama ─────────────────────────────────────────────────────────────
# Ollama server URL (for AI-powered business reports)
OLLAMA_HOST=http://localhost:11434

# Enable NLP report generation (true/false)
ENABLE_NLP=true

# ── SIEM Connectors ───────────────────────────────────────────────────────────
# Leave blank to disable a connector

# Elasticsearch
MUNIN_SIEM_ELASTIC_URL=
MUNIN_SIEM_ELASTIC_INDEX=munin-findings
MUNIN_SIEM_ELASTIC_API_KEY=
# Alternative: basic auth
MUNIN_SIEM_ELASTIC_USER=
MUNIN_SIEM_ELASTIC_PASS=

# Splunk HTTP Event Collector
MUNIN_SIEM_SPLUNK_URL=
MUNIN_SIEM_SPLUNK_TOKEN=

# Graylog GELF HTTP input
MUNIN_SIEM_GRAYLOG_URL=

# Syslog (RFC 5424)
MUNIN_SIEM_SYSLOG_HOST=
MUNIN_SIEM_SYSLOG_PORT=514
MUNIN_SIEM_SYSLOG_PROTO=udp   # udp or tcp

# Generic webhook (Slack, Teams, n8n, Zapier, etc.)
MUNIN_SIEM_WEBHOOK_URL=

# ── Docker / Compose (optional overrides) ────────────────────────────────────
# These are read by docker-compose.yml when running in containers
# MUNIN_DASHBOARD_PORT=5000
# OLLAMA_HOST=http://ollama:11434
